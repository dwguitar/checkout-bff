          "name": "2.2 Checkout - Pix sem dados de cartão (Sucesso 200 + Código Pix)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status HTTP deve ser 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Deve aprovar Pix retornando pixCode simulado e sem lastDigits', function () {",
                  "    pm.expect(jsonData.status).to.eql('APROVADO');",
                  "    pm.expect(jsonData.payment.method).to.eql('Pix');",
                  "    pm.expect(jsonData.payment.pixCode).to.be.a('string').and.include('br.gov.bcb.pix');",
                  "    pm.expect(jsonData.payment.lastDigits).to.be.undefined;",
                  "    pm.expect(jsonData.payment.amount).to.eql(59.90);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
